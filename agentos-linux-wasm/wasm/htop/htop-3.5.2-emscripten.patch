+
+EMSCRIPTEN_KEEPALIVE
+void agentos_set_terminal_size(int columns, int rows) {
+   char value[16];
+
+   snprintf(value, sizeof(value), "%d", columns > 20 ? columns : 80);
+   setenv("COLUMNS", value, 1);
+   snprintf(value, sizeof(value), "%d", rows > 10 ? rows : 24);
+   setenv("LINES", value, 1);
+   setenv("TERM", "xterm-256color", 1);
+   setenv("COLORTERM", "truecolor", 1);
+   setenv("HOME", "/home/root", 1);
+   setenv("USER", "root", 1);
+   setenv("SHELL", "/bin/sh", 1);
+}
+#endif
 
